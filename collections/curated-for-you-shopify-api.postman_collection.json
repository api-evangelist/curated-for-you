          "name": "Ensure Installed",
          "request": {
            "name": "Ensure Installed",
            "description": {
              "content": "Exchange session token for offline access token on first load.\n\nManaged installation bypasses /install and /callback — Shopify handles\nconsent itself and loads application_url directly in the iframe. This\nendpoint detects the missing store record and exchanges the session token\n(JWT) for a non-expiring offline access token via Shopify's token exchange\nAPI.\n\nIdempotent: returns immediately if store record already exists.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "shopify",
